# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated allowed CORS origins for production environments.
ALLOWED_ORIGINS=""

# Platform console super-admin credentials (set securely in your environment; leave blank to disable).
SUPER_ADMIN_NAME=""
SUPER_ADMIN_PIN=""
